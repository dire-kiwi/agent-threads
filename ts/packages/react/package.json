{
  "name": "@dire-kiwi/agent-threads-react",
  "version": "0.0.0",
  "description": "React hooks and components for agent-threads.",
  "license": "MIT",
  "repository": "github:dire-kiwi/agent-threads",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "test": "tsc --noEmit && vitest run",
    "stories": "ladle serve",
    "stories:build": "ladle build"
  },
  "dependencies": {
    "@dire-kiwi/agent-threads-protocol": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
